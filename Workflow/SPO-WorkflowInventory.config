<Configuration siteUrl="https://nrpdev.sharepoint.com" debug="true">
    <Credentials u="nickp@nrpdev.com" p="" />

	<Web serverRelativeUrl="/sites/SPD2010WorkflowSample" />	
	<Disabled description="Wrapped WEB list in this DISABLED element to ignore it in the code logic. Remove DISABLE element wrapping to use webs + lists">
		<Web serverRelativeUrl="/">
			<List webRelativeUrl="/lists/ComplianceEventQueue">
				<!--View>
					<Query>
						<Where>
							<Eq>
								<FieldRef Name='HPComplianceEventsListName' />
								<Value Type='Text'>Brush Compliance Calendar</Value>
							</Eq>
						</Where>
						<OrderBy>
							<FieldRef Name='ID' Ascending='TRUE'/>
						</OrderBy>
					</Query>
					<ViewFields>
						<FieldRef Name="HPComplianceEventsListName" />
						<FieldRef Name="HPComplianceEventID" />
						<FieldRef Name="HPComplianceStatus" />
						<FieldRef Name="HPComplianceDueDate" />
						<FieldRef Name="fRecurrence" />
						<FieldRef Name="HPComplianceMilestones" />
						<FieldRef Name="HPComplianceMilestoneStatus" />
						<FieldRef Name="HPMilestoneDueDate" />
						<FieldRef Name="HPComplianceEventGUID" />
					</ViewFields>
				</View-->
			</List>
			<List webRelativeUrl="/lists/ComplianceWFReportSchedules" />
		</Web>
		<Web serverRelativeUrl="/Finance">
			<List webRelativeUrl="/lists/ComplianceCalendar" />
		</Web>
		<Web serverRelativeUrl="/Operations/Brush">
			<List webRelativeUrl="/lists/BrushComplianceCalendar" />
			<List webRelativeUrl="/lists/BrushI_IIIComplianceCalendar" />
			<List webRelativeUrl="/lists/BrushIIComplianceCalendar" />
			<List webRelativeUrl="/lists/BrushIVComplianceCalendar" />
		</Web>
	</Disabled>
	
    <Workflow>
        <Instance status="Started" />
        <Instance status="Suspended" />
        <instance status="NotStarted" />
        <instance status="Canceling" />
        <instance status="Canceled" />
        <instance status="Terminated" />
        <instance status="Completed" />        
        <!--instance status="NotSpecified" /-->
        <!--instance status="Invalid" /-->
    </Workflow>
	
    <Output fileName="Cap-Metro-WorkflowStatus" webRelativeUrl="" />
	<Disabled>
		<Output fileName="HP-ComplianceItems-WorkflowStatus" webRelativeUrl="/ComplianceWFReports">
			<ViewFields>
				<FieldRef Name="HPComplianceEventsListName" />
				<FieldRef Name="HPComplianceEventID" />
				<FieldRef Name="HPComplianceStatus" />
				<FieldRef Name="HPComplianceDueDate" />
				<FieldRef Name="fRecurrence" />
				<FieldRef Name="HPComplianceMilestones" />
				<FieldRef Name="HPComplianceMilestoneStatus" />
				<FieldRef Name="HPMilestoneDueDate" />
				<FieldRef Name="HPComplianceEventGUID" />
			</ViewFields>
			<History>
				<View>
					<Query>
						<Where>
							<And>
								<Eq>
									<FieldRef Name='WorkflowInstance' />
									<Value Type='Text'>{$Instance.Id}</Value>
								</Eq>
								<IsNotNull>
									<FieldRef Name='Description' />
								</IsNotNull>
							</And>
						</Where>
						<OrderBy>
							<FieldRef Name='ID' Ascending='FALSE'/>
						</OrderBy>
					</Query>
					<RowLimit>1</RowLimit>
					<ViewFields>
						<FieldRef Name='Description' />
					</ViewFields>
				</View>
			</History>
			<Task>
				<View>
					<Query>
						<Where>
							<Eq>
								<FieldRef Name='WF4InstanceId' />
								<Value Type='Text'>{$Instance.Id}</Value>
							</Eq>
						</Where>
						<OrderBy>
							<FieldRef Name='ID' Ascending='FALSE'/>
						</OrderBy>
					</Query>
					<ViewFields>
						<FieldRef Name='Title' />
					</ViewFields>
				</View>
			</Task>
		</Output>
	</Disabled>
</Configuration>